      "example": "examples/15_typed_dense_solve.pas",
      "benchmark": "benchmarks/BenchmarkRunner.lpr",
      "tests": "tests/TestDenseMatrices.pas",
      "limitations": ["portable scalar kernel", "finite inputs required"]
